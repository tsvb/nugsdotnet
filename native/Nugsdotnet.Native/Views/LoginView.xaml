<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nugsdotnet.Native.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BrandBg}">
        <Border MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrandSurface}" BorderBrush="{StaticResource BrandBorder}"
                BorderThickness="1" CornerRadius="8" Padding="32,28">
            <StackPanel Spacing="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="6" Height="6" CornerRadius="1" VerticalAlignment="Center"
                                Background="{StaticResource BrandAccent}" />
                        <TextBlock Text="SIGN IN" Style="{StaticResource FaceplateLabelStyle}" />
                    </StackPanel>
                    <TextBlock Text="NUGSDOTNET" FontFamily="{StaticResource BrandDisplayFont}"
                               FontWeight="ExtraBold" FontSize="36" CharacterSpacing="40"
                               Foreground="{StaticResource BrandText}" />
                    <TextBlock Text="nugs.net account" FontFamily="{StaticResource BrandMonoFont}"
                               FontSize="12" Foreground="{StaticResource BrandDim}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="EMAIL" Style="{StaticResource FaceplateLabelStyle}" />
                    <TextBox x:Name="EmailInput"
                             PlaceholderText="you@example.com"
                             InputScope="EmailSmtpAddress"
                             IsSpellCheckEnabled="False"
                             IsEnabled="{Binding FieldsEnabled}"
                             KeyDown="OnCredentialKeyDown" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="PASSWORD" Style="{StaticResource FaceplateLabelStyle}" />
                    <PasswordBox x:Name="PasswordInput"
                                 PasswordRevealMode="Hidden"
                                 IsEnabled="{Binding FieldsEnabled}"
                                 KeyDown="OnCredentialKeyDown" />
                </StackPanel>

                <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn"
                        Style="{StaticResource PlayButtonStyle}" HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        IsEnabled="{Binding FieldsEnabled}" />

                <HyperlinkButton Content="Forgot password?"
                                 NavigateUri="https://www.nugs.net/account/forgotpassword"
                                 FontFamily="{StaticResource BrandMonoFont}" FontSize="11"
                                 Foreground="{StaticResource BrandDim}" />

                <TextBlock Text="{Binding Error}"
                           FontFamily="{StaticResource BrandMonoFont}" FontSize="12"
                           Foreground="{StaticResource BrandAccent2}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
