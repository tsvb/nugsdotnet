<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nugsdotnet.Native.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BrandBg}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="18" MaxWidth="640">
            <TextBlock Text="SETTINGS" FontFamily="{StaticResource BrandDisplayFont}"
                       FontWeight="ExtraBold" FontSize="30" Foreground="{StaticResource BrandText}" />

            <StackPanel Spacing="8">
                <TextBlock Text="AUDIO FORMAT" Style="{StaticResource FaceplateLabelStyle}" />
                <TextBlock Text="Preferred stream format when multiple tiers are available."
                           FontFamily="{StaticResource BrandMonoFont}" FontSize="11"
                           Foreground="{StaticResource BrandDim}" TextWrapping="Wrap" />
                <ComboBox x:Name="FormatBox" HorizontalAlignment="Left" MinWidth="220"
                          SelectionChanged="OnFormatChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="DEFAULT VOLUME" Style="{StaticResource FaceplateLabelStyle}" />
                <Slider Minimum="0" Maximum="100" Value="{Binding DefaultVolumePercent, Mode=TwoWay}"
                        Width="280" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource FaceplateLabelStyle}" />
                <TextBlock FontFamily="{StaticResource BrandMonoFont}" FontSize="11"
                           Foreground="{StaticResource BrandDim}" TextWrapping="Wrap" LineHeight="18"
                           Text="Ctrl+F — focus search&#x0a;Ctrl+Space — play / pause&#x0a;Ctrl+← / Ctrl+→ — previous / next track&#x0a;Ctrl+Shift+← / Ctrl+Shift+→ — back 15s / forward 30s&#x0a;Ctrl+D — toggle dashboard" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save" Click="OnSave" Style="{StaticResource PlayButtonStyle}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Foreground="{StaticResource BrandDim}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
