<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-agnostic core for the Windows client. Plain net10.0 (not -windows)
    on purpose: HttpClient + System.Text.Json, unit-testable on any OS without
    the Windows App SDK. DPAPI in NugsSessionStore is guarded by
    OperatingSystem.IsWindows() and is not exercised by the tests.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nugsdotnet.Native.Core</RootNamespace>
  </PropertyGroup>

    <ItemGroup>
    <!-- DPAPI for at-rest token encryption (Windows runtime only; compiles everywhere). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nugsdotnet.Native.Tests" />
  </ItemGroup>

</Project>
